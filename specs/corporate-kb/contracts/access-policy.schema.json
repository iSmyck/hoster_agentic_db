{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "access-policy.schema.json",
  "title": "Versioned Space access policy",
  "description": "PROPOSED canonical Git policy. It is the business authorization source together with current IdP groups. A document-level access field is not part of this contract and has no authorization effect.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_bundle_id",
    "repository_id",
    "space_id",
    "access_policy_path",
    "approval_policy_path",
    "default_private",
    "group_grants",
    "personal_grants"
  ],
  "properties": {
    "schema_version": {
      "const": "access-policy-v1"
    },
    "policy_bundle_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[a-z0-9][a-z0-9._:-]*$"
    },
    "repository_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "space_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "access_policy_path": {
      "$ref": "#/$defs/policyPath"
    },
    "approval_policy_path": {
      "$ref": "#/$defs/policyPath"
    },
    "default_private": {
      "const": true
    },
    "group_grants": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/groupGrant"
      }
    },
    "personal_grants": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/personalGrant"
      }
    }
  },
  "x-contract-invariants": [
    {
      "id": "ACCESS_SINGLE_SPACE_BUNDLE",
      "rule": "This policy binds exactly one repository_id to one space_id. Its policy_bundle_id, repository_id, space_id, policy paths, and revisions must match the approval policy activated in the same per-Space bundle.",
      "error": "POLICY_REVISION_MISMATCH"
    },
    {
      "id": "ACCESS_CANONICAL_POLICY_PATHS",
      "rule": "Policy paths are canonical NFC absolute repository paths with forward slashes, no empty, '.' or '..' segments, no trailing slash except root, and no backslash/control characters. Boundary projection to repository-relative form removes exactly the leading slash and is reversed by adding it; root maps to the empty prefix only for policy scope, never to a document path.",
      "error": "INVALID_POLICY"
    },
    {
      "id": "ACCESS_UNIQUE_GRANTS",
      "rule": "grant_id values are unique across group_grants and personal_grants; duplicate normalized external_group_ids within a grant are forbidden by schema.",
      "error": "INVALID_POLICY"
    }
  ],
  "$defs": {
    "policyPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 513,
      "pattern": "^/[^\\u0000-\\u001F\\\\]*$",
      "not": {
        "pattern": "(?:^|/)\\.\\.(?:/|$)"
      },
      "description": "Canonical absolute repository path using NFC Unicode and forward slashes."
    },
    "role": {
      "type": "string",
      "enum": ["reader", "author", "owner", "space_admin"]
    },
    "groupGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grant_id", "external_group_ids", "role"],
      "properties": {
        "grant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9._:-]*$"
        },
        "external_group_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "role": {
          "$ref": "#/$defs/role"
        }
      }
    },
    "personalGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grant_id", "stable_id", "role", "justification", "approval_evidence"],
      "properties": {
        "grant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9._:-]*$"
        },
        "stable_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "AD objectGUID, OpenLDAP entryUUID, or issuer-scoped OIDC sub; never email or login."
        },
        "role": {
          "$ref": "#/$defs/role"
        },
        "justification": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "approval_evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "./proposal-record.schema.json#/$defs/evidence"
          }
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
