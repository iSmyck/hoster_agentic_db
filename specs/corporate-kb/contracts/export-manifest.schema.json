              "publication": {
                "properties": {
                  "recovery_required": {
                    "const": false
                  },
                  "target_quarantined": {
                    "const": false
                  },
                  "retryable": {
                    "const": false
                  },
                  "no_merge_proven": {
                    "const": false
                  },
                  "attempts": {
