                  "action": {
                    "const": "cancelled"
                  }
                }
              },
              "publication": {
                "properties": {
                  "recovery_required": {
                    "const": false
                  },
                  "target_quarantined": {
                    "const": false
                  },
                  "retryable": {
                    "const": false
                  },
                  "attempts": {
                    "maxItems": 0
                  },
                  "reconciliation_evidence": {
                    "minItems": 1
