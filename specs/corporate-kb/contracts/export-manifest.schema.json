    },
    "assetExport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attachment", "storage_ref", "export_status"],
      "properties": {
        "attachment": {
          "$ref": "./front-matter.schema.json#/$defs/attachment"
        },
        "storage_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "Opaque immutable storage reference, not a mutable URL or credential."
        },
        "exported_object_sha256": {
          "$ref": "#/$defs/sha256",
          "description": "Must equal attachment.sha256 for a complete asset export."
        },
        "export_status": {
          "type": "string",
          "enum": ["exported", "missing", "rejected"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "export_status": {
                "const": "exported"
              }
            },
            "required": ["export_status"]
          },
          "then": {
            "required": ["exported_object_sha256"]
          }
        },
        {
          "if": {
            "properties": {
              "export_status": {
                "enum": ["missing", "rejected"]
              }
            },
            "required": ["export_status"]
          },
          "then": {
            "not": {
              "required": ["exported_object_sha256"]
            }
          }
        }
      ]
    }
  }
