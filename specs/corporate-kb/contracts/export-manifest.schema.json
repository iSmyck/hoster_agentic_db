                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "publication": {
                "properties": {
                  "outcome": {
                    "const": "merged"
                  }
                },
                "required": ["outcome"]
              }
            },
            "required": ["publication"]
          },
          "then": {
            "required": ["merge"],
