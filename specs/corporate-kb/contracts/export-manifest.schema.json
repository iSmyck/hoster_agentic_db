                      "const": "merged"
                    }
                  }
                },
                "required": ["outcome"]
              }
            },
            "required": ["publication"]
          },
          "then": {
            "not": {
              "required": ["merge"]
            }
          }
        },
        {
          "if": {
            "properties": {
              "publication": {
                "properties": {
