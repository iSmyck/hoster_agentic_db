# Local development environment for corp_ai_db
# Copy this file to .env and fill in real values.

# PostgreSQL
DATABASE_URL=postgresql+psycopg://corp_kb:corp_kb_dev@localhost:5432/corp_kb

# Identity service
IDENTITY_DATABASE_URL=postgresql+psycopg://corp_kb:corp_kb_dev@localhost:5432/corp_kb
IDENTITY_KB_AUTHZ_SCHEMA=kb_authz
IDENTITY_LOG_LEVEL=info

# Session service
SESSION_SECRET_KEY=__CHANGE_ME_IN_PRODUCTION_32BYTES__
SESSION_ACCESS_TTL_SECONDS=900
SESSION_REFRESH_TTL_SECONDS=86400
SESSION_SERVICE_URL=http://localhost:8004
SESSION_DATABASE_URL=postgresql+psycopg://corp_kb:corp_kb_dev@localhost:5432/corp_kb
SESSION_KB_SESSIONS_SCHEMA=kb_sessions
SESSION_LOG_LEVEL=info

# Git Orchestrator service
GO_DATABASE_URL=postgresql+psycopg://corp_kb:corp_kb_dev@localhost:5432/corp_kb
GO_KB_OPS_SCHEMA=kb_ops
GO_GITLAB_URL=http://localhost:8081
GO_GITLAB_TOKEN=__GITLAB_PERSONAL_ACCESS_TOKEN__
GO_LOG_LEVEL=info
GO_SESSION_SERVICE_URL=http://localhost:8004

# Retrieval service
RETRIEVAL_DATABASE_URL=postgresql+psycopg://corp_kb:corp_kb_dev@localhost:5432/corp_kb
RETRIEVAL_KB_INDEX_SCHEMA=kb_index
RETRIEVAL_IDENTITY_SERVICE_URL=http://localhost:8001
RETRIEVAL_GO_SERVICE_URL=http://localhost:8002
# Use 'stub' for live smoke/integration tests without a real Git Orchestrator.
RETRIEVAL_GO_CLIENT_MODE=http
RETRIEVAL_EMBEDDING_MODEL=kimi
RETRIVAL_EMBEDDING_DIMENSIONS=1024
RETRIEVAL_LOG_LEVEL=info

# Ingestion service
INGESTION_DATABASE_URL=postgresql+psycopg://corp_kb:corp_kb_dev@localhost:5432/corp_kb
INGESTION_KB_OPS_SCHEMA=kb_ops
INGESTION_GO_SERVICE_URL=http://localhost:8002
INGESTION_LOG_LEVEL=info

# External AI provider (kimi.ai)
KIMI_API_BASE_URL=https://api.kimi.com/coding/v1
KIMI_API_KEY=__YOUR_KIMI_API_KEY__
KIMI_EMBEDDING_MODEL=text-embedding-v2
KIMI_CHAT_MODEL=moonshot-v1-8k

# Keycloak identity provider integration
IDENTITY_ADAPTER=keycloak
KEYCLOAK_URL=http://localhost:8082
KEYCLOAK_REALM=corp-kb
KEYCLOAK_CLIENT_ID=identity-service
KEYCLOAK_CLIENT_SECRET=__KEYCLOAK_CLIENT_SECRET__
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=__KEYCLOAK_ADMIN_PASSWORD__
KEYCLOAK_TEST_USERNAME=testuser
KEYCLOAK_TEST_PASSWORD=testpass

# Open WebUI overlay dev proxy (vite.config.ts)
CORP_KB_IDENTITY_URL=http://localhost:8001
CORP_KB_GO_URL=http://localhost:8002
CORP_KB_RETRIEVAL_URL=http://localhost:8003
CORP_KB_INGESTION_URL=http://localhost:8004

# Backup service
BACKUP_STORAGE_PATH=_bmad-output/test-artifacts/d1/backups
BACKUP_GITLAB_URL=http://localhost:8081
BACKUP_GITLAB_TOKEN=__GITLAB_PERSONAL_ACCESS_TOKEN__
BACKUP_GITLAB_PROJECT_PATH_PREFIX=
BACKUP_DATABASE_URL=postgresql+psycopg://corp_kb:corp_kb_dev@localhost:5432/corp_kb
BACKUP_KB_OPS_SCHEMA=kb_ops
BACKUP_LIVE_SPACE_ID=corp-kb/sales

# Object-store backup settings (MinIO/S3)
BACKUP_MINIO_ENDPOINT=localhost:9000
BACKUP_MINIO_ACCESS_KEY=corp_kb
BACKUP_MINIO_SECRET_KEY=corp_kb_dev_minio
BACKUP_MINIO_USE_SSL=false
BACKUP_MINIO_BUCKET=kb-backups
BACKUP_MAX_UPLOAD_SIZE_BYTES=104857600

# PostgreSQL backup settings (read-only pg_dump source)
BACKUP_POSTGRES_HOST=localhost
BACKUP_POSTGRES_PORT=5432
BACKUP_POSTGRES_USER=corp_kb
BACKUP_POSTGRES_PASSWORD=corp_kb_dev
BACKUP_POSTGRES_DB=corp_kb
BACKUP_POSTGRES_SCHEMAS=kb_authz,kb_ops,kb_index

# Restore target environment credentials (keep separate from source backups)
BACKUP_RESTORE_GITLAB_URL=http://localhost:8081
BACKUP_RESTORE_GITLAB_TOKEN=__RESTORE_GITLAB_PERSONAL_ACCESS_TOKEN__
BACKUP_RESTORE_GITLAB_PROJECT_PATH_PREFIX=
BACKUP_RESTORE_POSTGRES_HOST=localhost
BACKUP_RESTORE_POSTGRES_PORT=5432
BACKUP_RESTORE_POSTGRES_USER=corp_kb_restore
BACKUP_RESTORE_POSTGRES_PASSWORD=__RESTORE_POSTGRES_PASSWORD__
BACKUP_RESTORE_POSTGRES_DB=corp_kb_restore
BACKUP_RESTORE_MINIO_ENDPOINT=localhost:9000
BACKUP_RESTORE_MINIO_ACCESS_KEY=corp_kb_restore
BACKUP_RESTORE_MINIO_SECRET_KEY=__RESTORE_MINIO_SECRET_KEY__
BACKUP_RESTORE_MINIO_USE_SSL=false
BACKUP_RESTORE_MINIO_BUCKET=kb-restores
RUN_LIVE_RESTORE_TESTS=0
