# Local development stack configuration for corp-ai-db G1 vertical slice.
# Copy to .env and adjust as needed. No production secrets.

# -----------------------------------------------------------------------------
# Shared infrastructure
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=corp_kb
POSTGRES_PASSWORD=corp_kb_dev
POSTGRES_DB=corp_kb

DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=corp_kb
MINIO_SECRET_KEY=corp_kb_dev_minio
MINIO_USE_SSL=false
MINIO_BUCKET=kb-backups

GITLAB_URL=http://localhost:8081
GO_GITLAB_URL=${GITLAB_URL}
GITLAB_TOKEN=
GO_GITLAB_TOKEN=${GITLAB_TOKEN}

KEYCLOAK_URL=http://localhost:8082
KEYCLOAK_REALM=corp-kb
KEYCLOAK_CLIENT_ID=identity-service
KEYCLOAK_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Identity + AuthZ service (port 8001)
# -----------------------------------------------------------------------------
IDENTITY_DATABASE_URL=${DATABASE_URL}
IDENTITY_KB_AUTHZ_SCHEMA=kb_authz
IDENTITY_ADAPTER=stub
IDENTITY_KEYCLOAK_URL=${KEYCLOAK_URL}
IDENTITY_KEYCLOAK_REALM=${KEYCLOAK_REALM}
IDENTITY_KEYCLOAK_CLIENT_ID=${KEYCLOAK_CLIENT_ID}
IDENTITY_KEYCLOAK_CLIENT_SECRET=${KEYCLOAK_CLIENT_SECRET}
IDENTITY_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Session service (port 8004)
# -----------------------------------------------------------------------------
SESSION_DATABASE_URL=${DATABASE_URL}
SESSION_KB_SESSIONS_SCHEMA=kb_sessions
SESSION_SECRET_KEY=local-dev-secret-key-change-me-in-production
SESSION_ACCESS_TTL_SECONDS=900
SESSION_REFRESH_TTL_SECONDS=86400
SESSION_ISSUER=corp-ai-db-session
SESSION_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Git Orchestrator (port 8002)
# -----------------------------------------------------------------------------
GO_DATABASE_URL=${DATABASE_URL}
GO_KB_OPS_SCHEMA=kb_ops
GO_GITLAB_URL=${GITLAB_URL}
GO_GITLAB_TOKEN=${GITLAB_TOKEN}
GO_GITLAB_ADAPTER=stub
GO_KB_ALLOWED_SPACE_IDS=corp-kb/sales
GO_KB_TARGET_BRANCHES=main
GO_KB_APPROVER_IDS=approver-1
GO_SESSION_SERVICE_URL=http://localhost:8004
GO_IDENTITY_SESSION_URL=http://localhost:8001/api/v1/auths/
GO_POLICY_BUNDLE_ID=sales-policy-bundle
GO_ACCESS_POLICY_REVISION=a000000000000000000000000000000000000000
GO_APPROVAL_POLICY_REVISION=b000000000000000000000000000000000000000
GO_CORS_ALLOW_ORIGINS=http://localhost:3100,http://127.0.0.1:3100,http://localhost:5050,http://127.0.0.1:5050
GO_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Retrieval service (port 8003)
# -----------------------------------------------------------------------------
RETRIEVAL_DATABASE_URL=${DATABASE_URL}
RETRIEVAL_KB_INDEX_SCHEMA=kb_index
RETRIEVAL_IDENTITY_SERVICE_URL=http://localhost:8001
RETRIEVAL_GO_SERVICE_URL=http://localhost:8002
RETRIEVAL_GO_CLIENT_MODE=stub
RETRIEVAL_EMBEDDING_MODEL=stub-deterministic
RETRIEVAL_EMBEDDING_DIMENSIONS=384
RETRIEVAL_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Backup service (port 8005)
# -----------------------------------------------------------------------------
BACKUP_DATABASE_URL=${DATABASE_URL}
BACKUP_KB_OPS_SCHEMA=kb_ops
BACKUP_GITLAB_URL=${GITLAB_URL}
BACKUP_GITLAB_TOKEN=${GITLAB_TOKEN}
BACKUP_MINIO_ENDPOINT=${MINIO_ENDPOINT}
BACKUP_MINIO_ACCESS_KEY=${MINIO_ACCESS_KEY}
BACKUP_MINIO_SECRET_KEY=${MINIO_SECRET_KEY}
BACKUP_MINIO_USE_SSL=${MINIO_USE_SSL}
BACKUP_MINIO_BUCKET=${MINIO_BUCKET}
BACKUP_STORAGE_PATH=_bmad-output/test-artifacts/d1/backups
BACKUP_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# kb-ingestion service (port 8006). Product schema stays in GO kb_ops (ADR-015).
# -----------------------------------------------------------------------------
KB_INGEST_MAX_UPLOAD_SIZE_BYTES=104857600
KB_INGEST_OBJECT_STORE_BUCKET=kb-ingest
KB_INGEST_MINIO_ENDPOINT=
KB_INGEST_MINIO_ACCESS_KEY=
KB_INGEST_MINIO_SECRET_KEY=
KB_INGEST_MINIO_USE_SSL=false
KB_INGEST_GO_BASE_URL=http://127.0.0.1:8002
KB_INGEST_IDENTITY_BASE_URL=http://127.0.0.1:8001
KB_INGEST_SESSION_URL=http://127.0.0.1:8004
KB_INGEST_GO_AUTHOR_ID=author-1
KB_INGEST_GO_APPROVER_ID=approver-1
KB_INGEST_GITLAB_URL=http://localhost:8081
KB_INGEST_REQUIRE_IDENTITY=false
KB_INGEST_DOCLING_EVIDENCE_GATE=false

# -----------------------------------------------------------------------------
# External AI provider (OpenAI-compatible; KIMI by default)
# -----------------------------------------------------------------------------
KIMI_API_BASE_URL=https://api.kimi.com/coding/v1
KIMI_API_KEY=
KIMI_EMBEDDING_MODEL=text-embedding-v2
KIMI_CHAT_MODEL=moonshot-v1-8k

# Open WebUI speaks OpenAI-compatible APIs. The orchestrator maps KIMI_API_*
# to these vars automatically; set them explicitly if you use another provider.
OPENAI_API_BASE_URL=https://api.kimi.com/coding/v1
OPENAI_API_KEY=
ENABLE_DIRECT_CONNECTIONS=true

# -----------------------------------------------------------------------------
# Open WebUI (port 3100)
# -----------------------------------------------------------------------------
# Runtime profile (see baseline.md §3).
ENABLE_DB_MIGRATIONS=false
DATABASE_SCHEMA=openwebui
VECTOR_DB=pgvector
WEBUI_SECRET_KEY=local-dev-openwebui-secret-key
WEBUI_NAME="hoster.by Knowledge Base"

# Default knowledge-backed model created by scripts/seed_openwebui_kb.py.
KB_SEED_NAME="corp-ai-db project docs"
KB_MODEL_ID=hoster-assistant
KB_BASE_MODEL_ID=kimi-for-coding
