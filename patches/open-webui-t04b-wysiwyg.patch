+	let richTextEditor: RichTextInput;
+
+	const isMarkdownFile = (path: string) => /\.(md|markdown|mdx)$/i.test(path);
+	const extractFrontMatter = (content: string) => {
+		const match = content.match(/^---\r?\n([\s\S]*?)\r?\n---\r?\n?/);
+		if (match) {
+			return { front: match[0], body: content.slice(match[0].length) };
+		}
+		return { front: '', body: content };
+	};
+	const syncVisualDraft = () => {
+		state = { ...state, draft: visualFrontMatter + visualBody };
+	};
+	const enterVisualMode = () => {
+		const source = state.draft ?? state.indexed ?? '';
+		const parsed = extractFrontMatter(source);
+		visualFrontMatter = parsed.front;
+		visualBody = parsed.body;
+		visualMode = true;
+	};
+	const exitVisualMode = () => {
+		visualMode = false;
+	};
+	const onVisualChange = (e: { md: string }) => {
+		visualBody = e.md;
+		syncVisualDraft();
+	};
