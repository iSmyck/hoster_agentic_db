{
	"name": "corp-ai-db-open-webui-overlay",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"setup": "./setup-openwebui.sh",
		"kb:merge": "node scripts/merge-overlay.js",
		"kb:check": "npm run kb:merge && cd upstream && npm run check",
		"kb:build": "npm run kb:merge && cd upstream && node --max-old-space-size=6144 node_modules/vite/bin/vite.js build",
		"kb:test": "vitest run --config vitest.config.ts",
		"kb:test:watch": "vitest --config vitest.config.ts",
		"kb:syntax": "node --check scripts/merge-overlay.js"
	},
	"peerDependencies": {
		"svelte": "^5.53.10",
		"typescript": "^5.5.4",
		"vite": "^5.4.21"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^4.0.4",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^22.0.0",
		"jsdom": "^24.1.3",
		"typescript": "^5.5.4",
		"vitest": "^1.6.1"
	},
	"dependencies": {}
}
